{
  "realm": "stroykontrol",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "keycloak.v2",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru"
  ],
  "defaultLocale": "ru",
  "displayName": "СтройКонтроль",
  "roles": {
    "realm": [
      {
        "name": "foreman",
        "description": "Прораб"
      },
      {
        "name": "manager",
        "description": "Руководитель проекта"
      },
      {
        "name": "inspector",
        "description": "Инспектор"
      },
      {
        "name": "admin",
        "description": "Администратор"
      }
    ]
  },
  "clients": [
    {
      "clientId": "stroykontrol-web",
      "name": "СтройКонтроль (веб)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:5180",
      "baseUrl": "http://localhost:5180",
      "redirectUris": [
        "http://localhost:5180/*"
      ],
      "webOrigins": [
        "http://localhost:5180",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5180/*"
      }
    },
    {
      "clientId": "stroykontrol-backend",
      "name": "СтройКонтроль (сервер): управление сотрудниками",
      "description": "Служебный клиент: админка СтройКонтроля меняет через него сотрудников, роли и пароли. Секрет — только для разработки.",
      "enabled": true,
      "publicClient": false,
      "secret": "stroykontrol-dev-backend-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
